# GuineaPig input for the muon-collider incoherent-pair-production runs used by
# data/incoherentpairs.txt.  This file replaces the acc.dat shipped inside the
# ghcr.io/lawrenceleejr/guineapig_mumu image; see run_pairs.sh.
#
# Beam parameters are the IMCC interim-report target parameters,
# arXiv:2407.12450 Table 1.1, Scenario 1:
#   Stage 1 -> 3 TeV, Stage 2 -> 10 TeV.
#
# Units (GuineaPig convention):
#   particles : particles per bunch in units of 1e10
#   energy    : GeV per beam
#   emitt_x/y : normalised emittance in 1e-6 m rad
#   beta_x/y  : mm
#   sigma_z   : um
#   charge_sign : -1 for opposite-sign beams

# ---------------------------------------------------------------- 10 TeV ---
# E_cm = 10 TeV, N = 1.8e12, beta* = 1.5 mm, eps_n = 25 um, sigma_z = 1.5 mm
# -> sigma_x = sigma_y = 0.9 um (Table 1.1 quotes 0.9 um)
$ACCELERATOR:: mumu10tev
     {
     energy=5000.0;
     particles=180.0;
     beta_x=1.5;
     beta_y=beta_x.1;
     emitt_x=25;
     emitt_y=emitt_x.1;
     sigma_z=1500.0;
     charge_sign=-1.0;
     offset_y=0.0;
     }

# ----------------------------------------------------------------- 3 TeV ---
# E_cm = 3 TeV, N = 2.2e12, beta* = 5.0 mm, eps_n = 25 um, sigma_z = 5.0 mm
# -> sigma_x = sigma_y = 3.0 um (Table 1.1 quotes 3 um)
$ACCELERATOR:: mumu3tev
     {
     energy=1500.0;
     particles=220.0;
     beta_x=5.0;
     beta_y=beta_x.1;
     emitt_x=25;
     emitt_y=emitt_x.1;
     sigma_z=5000.0;
     charge_sign=-1.0;
     offset_y=0.0;
     }

# --------------------------------------------------------------------------
# Pair-production parameter sets.  store_pairs=2 writes every produced pair
# lepton to pairs0.dat at production time (energy vx vy vz x y z, energy in GeV
# and signed by charge), which is what the pT > 15 MeV count is made from.
# track_pairs=0 because the no-FFTW build crashes tracking pairs across grids;
# production itself is unaffected.
# rndm_load/rndm_save carry the random state between successive invocations, so
# repeated runs in the same directory are independent bunch crossings.

$PARAMETERS:: pairs10tev
     {
     n_x=64 ;
     n_y=64 ;
     n_z=40 ;
     n_t=5 ;
     cut_x=6.0*sigma_x.1 ;
     cut_y=6.0*sigma_y.1 ;
     cut_z=2.0*sigma_z.1 ;
     n_m=40000;
     do_eloss=1;
     electron_ratio=1.0;
     do_photons=1;
     store_photons=0;
     do_hadrons=0;
     hadron_ratio=1;
     store_hadrons=0;
     store_beam=0;
     do_pairs=1;
     track_pairs=0;
     pair_step=0.2;
     store_pairs=2;
     grids=1;
     load_beam=0;
     load_photons=0;
     ecm_min_gg=9990.0;
     do_lumi=0;
     do_compt=0;
     beam_size=0;
     silent=1;
     rndm_load=1;
     rndm_save=1;
     waist_y=0.0;
     waist_x=0.0;
     charge_sign=-1.0;
}

$PARAMETERS:: pairs3tev
     {
     n_x=64 ;
     n_y=64 ;
     n_z=40 ;
     n_t=5 ;
     cut_x=6.0*sigma_x.1 ;
     cut_y=6.0*sigma_y.1 ;
     cut_z=2.0*sigma_z.1 ;
     n_m=40000;
     do_eloss=1;
     electron_ratio=1.0;
     do_photons=1;
     store_photons=0;
     do_hadrons=0;
     hadron_ratio=1;
     store_hadrons=0;
     store_beam=0;
     do_pairs=1;
     track_pairs=0;
     pair_step=0.2;
     store_pairs=2;
     grids=1;
     load_beam=0;
     load_photons=0;
     ecm_min_gg=2990.0;
     do_lumi=0;
     do_compt=0;
     beam_size=0;
     silent=1;
     rndm_load=1;
     rndm_save=1;
     waist_y=0.0;
     waist_x=0.0;
     charge_sign=-1.0;
}

# Cheap luminosity-only crossing used only to advance the random state so that
# parallel chains start from different seeds (see run_pairs.sh).
$PARAMETERS:: seed
     {
     n_x=16 ; n_y=16 ; n_z=10 ; n_t=2 ;
     cut_x=6.0*sigma_x.1 ;
     cut_y=6.0*sigma_y.1 ;
     cut_z=2.0*sigma_z.1 ;
     n_m=2000;
     do_eloss=0; electron_ratio=1.0; do_photons=0; store_photons=0;
     do_hadrons=0; hadron_ratio=1; store_hadrons=0; store_beam=0;
     do_pairs=0; track_pairs=0; store_pairs=0; grids=0;
     load_beam=0; load_photons=0; ecm_min_gg=300.0;
     do_lumi=0; do_compt=0; beam_size=0; silent=1;
     rndm_load=1; rndm_save=1;
     waist_y=0.0; waist_x=0.0; charge_sign=-1.0;
}

# --------------------------------------------------------------------------
# Cheaper variants of the two sets above: half the transverse and longitudinal
# grid, fewer timesteps, a quarter of the macroparticles. About an order of
# magnitude faster per crossing, which is what makes the rare p_T > 1.4 GeV tail
# reachable at 3 TeV. Validated against the full-resolution set at 10 TeV
# before being used for physics -- see the README.

$PARAMETERS:: pairs10tev_fast
     {
     n_x=32 ;
     n_y=32 ;
     n_z=20 ;
     n_t=3 ;
     cut_x=6.0*sigma_x.1 ;
     cut_y=6.0*sigma_y.1 ;
     cut_z=2.0*sigma_z.1 ;
     n_m=10000;
     do_eloss=1;
     electron_ratio=1.0;
     do_photons=1;
     store_photons=0;
     do_hadrons=0;
     hadron_ratio=1;
     store_hadrons=0;
     store_beam=0;
     do_pairs=1;
     track_pairs=0;
     pair_step=0.2;
     store_pairs=2;
     grids=1;
     load_beam=0;
     load_photons=0;
     ecm_min_gg=9990.0;
     do_lumi=0;
     do_compt=0;
     beam_size=0;
     silent=1;
     rndm_load=1;
     rndm_save=1;
     waist_y=0.0;
     waist_x=0.0;
     charge_sign=-1.0;
}


$PARAMETERS:: pairs3tev_fast
     {
     n_x=32 ;
     n_y=32 ;
     n_z=20 ;
     n_t=3 ;
     cut_x=6.0*sigma_x.1 ;
     cut_y=6.0*sigma_y.1 ;
     cut_z=2.0*sigma_z.1 ;
     n_m=10000;
     do_eloss=1;
     electron_ratio=1.0;
     do_photons=1;
     store_photons=0;
     do_hadrons=0;
     hadron_ratio=1;
     store_hadrons=0;
     store_beam=0;
     do_pairs=1;
     track_pairs=0;
     pair_step=0.2;
     store_pairs=2;
     grids=1;
     load_beam=0;
     load_photons=0;
     ecm_min_gg=2990.0;
     do_lumi=0;
     do_compt=0;
     beam_size=0;
     silent=1;
     rndm_load=1;
     rndm_save=1;
     waist_y=0.0;
     waist_x=0.0;
     charge_sign=-1.0;
}

# Cheap luminosity-only crossing used only to advance the random state so that
# parallel chains start from different seeds (see run_pairs.sh).
